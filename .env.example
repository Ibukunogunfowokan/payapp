# Postgres
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=
# Cloud only (CloudAMQP), leave blank locally
RABBITMQ_URL=

# Paystack (test mode only)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# How the API talks to Paystack: direct (default) or ductape
PAYMENTS_PROVIDER=direct
# Only needed for ductape. Optional overrides: DUCTAPE_PRODUCT, DUCTAPE_ENV, DUCTAPE_DATABASE, DUCTAPE_BROKER
DUCTAPE_ACCESS_KEY=

# Email (local: Mailpit, no auth)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_FROM_ADDRESS=
# Cloud only (Brevo or Resend), leave blank locally
EMAIL_API_KEY=

# Where the app runs (localhost = app on your Mac, infra in Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_BASE_URL=http://localhost:5146

# SMTP login (blank for Mailpit; Brevo/Resend in the cloud, password goes in EMAIL_API_KEY)
EMAIL_SMTP_USER=
EMAIL_SMTP_ENABLE_SSL=false
